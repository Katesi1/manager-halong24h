# ============ Bot Telegram HaLong24h — cấu hình ============
# Copy file này thành `.env` cùng thư mục rồi điền giá trị thật.
# File `.env` đã được gitignore — KHÔNG commit.

# Backend API (mặc định production)
HALONG_API_BASE_URL=http://api.halong24h.com

# ⚠️ Tài khoản BE cho bot đăng nhập.
# BE giới hạn 1 phiên web / tài khoản — bot login sẽ ĐÁ phiên web đang đăng nhập
# của cùng tài khoản. Nên tạo TÀI KHOẢN RIÊNG cho bot (role ADMIN để nhận đủ
# cảnh báo admin; nếu không phải ADMIN, các watcher admin tự tắt, vẫn nhận
# notifications + bookings trong scope tài khoản đó).
HALONG_BOT_EMAIL=bot@example.com
HALONG_BOT_PASSWORD=

# Bot token lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA...

# Chat ID nơi nhận thông báo. Có thể là:
#  - 1 chat cá nhân (số dương, vd 7756878427)
#  - 1 nhóm/kênh (số âm, vd -1001234567890) — mọi thành viên nhóm đều nhận
#  - NHIỀU chat cách nhau bởi dấu phẩy, vd: 7756878427,123456789,-1001234567890
TELEGRAM_CHAT_ID=

# Chu kỳ poll (giây, tối thiểu 10, mặc định 30)
POLL_INTERVAL_SEC=30

# Số tin tối đa gửi mỗi chu kỳ (chống spam khi có đợt dữ liệu lớn)
MAX_MESSAGES_PER_CYCLE=25
