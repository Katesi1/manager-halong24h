# =============================================================================
# REST API (data source chính — Auth, Properties, Dashboard)
# =============================================================================
# Base URL của BE (xem api-spec-website-admin.md)
# LƯU Ý: Spec ghi /api/v1 nhưng BE chạy không có prefix. Verify: GET /properties/public → 200.
NEXT_PUBLIC_API_BASE_URL=http://103.183.118.148:3000

# Mock mode cho từng module (api | mock). Mặc định mock cho module chưa có endpoint.
# Khi BE ra endpoint thật → đổi sang `api` và đảm bảo container.ts có ApiXxxRepository.
NEXT_PUBLIC_DATA_MODE_BOOKINGS=mock
NEXT_PUBLIC_DATA_MODE_CALENDAR=mock
NEXT_PUBLIC_DATA_MODE_PAYMENTS=mock
NEXT_PUBLIC_DATA_MODE_KYC=mock
NEXT_PUBLIC_DATA_MODE_PROPERTIES=mock

# Dev only: bỏ qua login, giả lập profile. Bật = 1, tắt = comment/xoá.
# Default role = customer (least-privileged) — đổi role qua cookie `dev_role`.
# DEV_BYPASS_AUTH=1

# =============================================================================
# Supabase (LEGACY — chỉ còn dùng cho VietQR webhook + storage nếu có)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Service role key — CHỈ dùng ở server (route handlers / server actions). KHÔNG đưa ra browser.
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Site URL (dùng cho auth redirects, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sale Calendar (preview xem lịch CTV — Next 16 standalone, mock data, port 3003)
# Production: thay bằng domain thật, ví dụ https://sale.halong24h.com
NEXT_PUBLIC_SALE_CALENDAR_URL=http://localhost:3003

# Storage bucket name
NEXT_PUBLIC_STORAGE_BUCKET=halong24h

# VietQR config (Mode B — Module 10)
# Bank BIN list: https://api.vietqr.io/v2/banks. 970422=MB, 970436=Vietcombank, 970432=VPB, 970418=BIDV
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NUMBER=0123456789
VIETQR_ACCOUNT_NAME=HALONG24H_PLATFORM

# SePay webhook (https://my.sepay.vn → Settings → Webhook). Tạo random secret 32 ký tự.
SEPAY_WEBHOOK_SECRET=replace_with_strong_random_string

# ===========================================================================
# Production checklist:
# - NEXT_PUBLIC_SITE_URL phải đổi thành domain thật (https://halong24h.com)
# - Trên Vercel/Coolify, thêm tất cả các vars trên vào project settings
# - SEPAY_WEBHOOK_SECRET phải khớp với secret config trên SePay dashboard
# - Sau khi deploy, vào SePay → set webhook URL = https://halong24h.com/api/webhooks/sepay
# ===========================================================================
