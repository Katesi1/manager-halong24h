# =============================================================================
# REST API
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=https://manage.halong24h.com
API_BASE_URL=https://manage.halong24h.com

# Data mode cho từng module (api | mock).
NEXT_PUBLIC_DATA_MODE_PROPERTIES=api
NEXT_PUBLIC_DATA_MODE_BOOKINGS=api
NEXT_PUBLIC_DATA_MODE_CALENDAR=api
NEXT_PUBLIC_DATA_MODE_PAYMENTS=api
NEXT_PUBLIC_DATA_MODE_DISPUTES=api
NEXT_PUBLIC_DATA_MODE_KYC=api

# =============================================================================
# Site
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://manage.halong24h.com
NEXT_PUBLIC_SALE_CALENDAR_URL=https://sale.halong24h.com
NEXT_PUBLIC_STORAGE_BUCKET=halong24h

# =============================================================================
# Google Sign-In (Spec v1.7 §2.2 — POST /auth/google)
# =============================================================================
# Lấy tại https://console.cloud.google.com/apis/credentials
# Type: "OAuth client ID" → "Web application"
# Authorized JS origins: http://localhost:3001, https://manage.halong24h.com
# Authorized redirect URIs: http://localhost:3001/auth/callback (optional cho One Tap)
# Bỏ trống → button Google Sign-In hiện hint "chưa cấu hình", login email vẫn chạy.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# =============================================================================
# VietQR / SePay
# =============================================================================
VIETQR_BANK_BIN=970422
VIETQR_ACCOUNT_NUMBER=0123456789
VIETQR_ACCOUNT_NAME=HALONG24H_PLATFORM
SEPAY_WEBHOOK_SECRET=replace_with_strong_random_string
